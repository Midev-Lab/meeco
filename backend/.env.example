# --- app ---
ALLOWED_ORIGINS=*                  # lock this down in production (comma separated). file:// pages send Origin: null
CHUNK_SECONDS=30                   # S3 safety-path chunk length
MAX_SESSION_SECONDS=9000           # 2h30m, under AssemblyAI's 3h streaming cap

# --- storage: local (dev) or s3 ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.data
# STORAGE_BACKEND=s3
# S3_BUCKET=meeco-prod
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- transcription: fake (dev) or assemblyai ---
TRANSCRIBER=fake
ASSEMBLYAI_API_KEY=
STREAM_SPEECH_MODEL=universal-3-6-pro
VOICE_FOCUS=near-field             # near-field | far-field | off
VOICE_FOCUS_THRESHOLD=0.7

# --- AI: fake (dev) or groq ---
LLM_PROVIDER=fake
GROQ_API_KEY=
GROQ_MODEL_TITLE=llama-3.1-8b-instant
GROQ_MODEL_TEXT=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=openai/gpt-oss-120b
